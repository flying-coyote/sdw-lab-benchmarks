# BC arm (STREAM-COMPLEXITY v2, added at freeze by owner ruling 2026-11-03): the SAME
# batch/batch_job.py as the July B arm, packaged in one container. Base pinned by digest
# (python:3.12-slim as pulled 2026-11-03); DuckDB/pyarrow pinned to the July versions.
FROM python:3.12-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203
RUN pip install --no-cache-dir duckdb==1.5.3 pyarrow==24.0.0
COPY lib/common.py /app/lib/common.py
COPY stream-complexity/gen_corpus.py /app/stream-complexity/gen_corpus.py
COPY stream-complexity/batch/ /app/stream-complexity/batch/
WORKDIR /app/stream-complexity
ENTRYPOINT ["python3", "batch/batch_job.py"]
