 "sql": {
  "a1_ingest_mail": "SELECT metadata_uid FROM api WHERE api_operation='mail.fetch'",
  "a2_ingest_repo": "SELECT metadata_uid FROM api WHERE api_operation='issue.read' OR api_operation='pr.read'",
  "a3_collect_mailbox": "SELECT metadata_uid FROM api WHERE api_operation='mail.search' OR api_operation='contacts.list'",
  "a4_read_procenv": "SELECT metadata_uid FROM api WHERE api_operation='file.read' AND api_request_data LIKE '%/proc/self/environ%' ESCAPE '\\'",
  "a5_outbound_offlist": "SELECT metadata_uid FROM api WHERE (api_operation='http.open' OR api_operation='web.fetch') AND (NOT COALESCE((dst_endpoint_hostname='docs.python.org' OR dst_endpoint_hostname='github.com' OR dst_endpoint_hostname='api.github.com' OR dst_endpoint_hostname='pypi.org' OR dst_endpoint_hostname='intranet.example' OR dst_endpoint_hostname='wiki.example' OR dst_endpoint_hostname='calendar.example' OR dst_endpoint_hostname='mail.example' OR dst_endpoint_hostname='registry.example'), 0))",
  "a6_credential_shape": "SELECT metadata_uid FROM api WHERE (api_operation='web.fetch' OR api_operation='bash.exec') AND api_request_data LIKE '%api03-%' ESCAPE '\\'",
  "b3_session_sql": "WITH RECURSIVE \nlegs AS (\n  SELECT actor_session_uid AS s, time_epoch AS t, dst_endpoint_hostname AS h, api_request_data AS d,\n    CASE WHEN api_operation IN ('mail.fetch','issue.read','pr.read') THEN 1\n         WHEN api_operation IN ('mail.search','contacts.list')\n           OR (api_operation = 'file.read' AND (api_request_data LIKE '%/proc/self/environ%'\n               OR api_request_data LIKE '%.env%' OR api_request_data LIKE '%credentials.json%')) THEN 2\n         WHEN api_operation IN ('http.open','web.fetch') AND dst_endpoint_hostname NOT IN ('docs.python.org', 'github.com', 'api.github.com', 'pypi.org', 'intranet.example', 'wiki.example', 'calendar.example', 'mail.example', 'registry.example') THEN 3\n    END AS leg\n  FROM api)\nSELECT s AS unit FROM legs WHERE leg IS NOT NULL GROUP BY s HAVING COUNT(DISTINCT leg) = 3 AND MAX(t) - MIN(t) <= 3600",
  "b4_session_sql_qualified": "WITH RECURSIVE \nlegs AS (\n  SELECT actor_session_uid AS s, time_epoch AS t, dst_endpoint_hostname AS h, api_request_data AS d,\n    CASE WHEN api_operation IN ('mail.fetch','issue.read','pr.read') THEN 1\n         WHEN api_operation IN ('mail.search','contacts.list')\n           OR (api_operation = 'file.read' AND (api_request_data LIKE '%/proc/self/environ%'\n               OR api_request_data LIKE '%.env%' OR api_request_data LIKE '%credentials.json%')) THEN 2\n         WHEN api_operation IN ('http.open','web.fetch') AND dst_endpoint_hostname NOT IN ('docs.python.org', 'github.com', 'api.github.com', 'pypi.org', 'intranet.example', 'wiki.example', 'calendar.example', 'mail.example', 'registry.example') THEN 3\n    END AS leg\n  FROM api),\nbursts AS (\n  SELECT s, h FROM legs WHERE leg = 3 GROUP BY s, h HAVING COUNT(*) >= 20 AND MAX(t) - MIN(t) <= 300),\nqlegs AS (\n  SELECT l.s, l.t, CASE WHEN l.leg = 3 AND NOT (l.d LIKE '%api03-%' OR EXISTS (SELECT 1 FROM bursts b WHERE b.s = l.s AND b.h = l.h))\n                        THEN NULL ELSE l.leg END AS leg\n  FROM legs l)\nSELECT s AS unit FROM qlegs WHERE leg IS NOT NULL GROUP BY s HAVING COUNT(DISTINCT leg) = 3 AND MAX(t) - MIN(t) <= 3600",
  "c1_walk_sql": "WITH RECURSIVE \nlegs AS (\n  SELECT actor_session_uid AS s, time_epoch AS t, dst_endpoint_hostname AS h, api_request_data AS d,\n    CASE WHEN api_operation IN ('mail.fetch','issue.read','pr.read') THEN 1\n         WHEN api_operation IN ('mail.search','contacts.list')\n           OR (api_operation = 'file.read' AND (api_request_data LIKE '%/proc/self/environ%'\n               OR api_request_data LIKE '%.env%' OR api_request_data LIKE '%credentials.json%')) THEN 2\n         WHEN api_operation IN ('http.open','web.fetch') AND dst_endpoint_hostname NOT IN ('docs.python.org', 'github.com', 'api.github.com', 'pypi.org', 'intranet.example', 'wiki.example', 'calendar.example', 'mail.example', 'registry.example') THEN 3\n    END AS leg\n  FROM api),\nparents AS (SELECT DISTINCT actor_session_uid AS s, delegation_parent_uid AS p FROM api),\nwalk AS (\n  SELECT s, s AS root, 0 AS depth FROM parents WHERE p IS NULL\n  UNION ALL\n  SELECT c.s, w.root, w.depth + 1 FROM parents c JOIN walk w ON c.p = w.s WHERE w.depth < 8)\nSELECT w.root AS unit FROM legs l JOIN walk w ON w.s = l.s WHERE l.leg IS NOT NULL GROUP BY w.root HAVING COUNT(DISTINCT leg) = 3 AND MAX(t) - MIN(t) <= 3600",
  "c2_walk_sql_qualified": "WITH RECURSIVE \nlegs AS (\n  SELECT actor_session_uid AS s, time_epoch AS t, dst_endpoint_hostname AS h, api_request_data AS d,\n    CASE WHEN api_operation IN ('mail.fetch','issue.read','pr.read') THEN 1\n         WHEN api_operation IN ('mail.search','contacts.list')\n           OR (api_operation = 'file.read' AND (api_request_data LIKE '%/proc/self/environ%'\n               OR api_request_data LIKE '%.env%' OR api_request_data LIKE '%credentials.json%')) THEN 2\n         WHEN api_operation IN ('http.open','web.fetch') AND dst_endpoint_hostname NOT IN ('docs.python.org', 'github.com', 'api.github.com', 'pypi.org', 'intranet.example', 'wiki.example', 'calendar.example', 'mail.example', 'registry.example') THEN 3\n    END AS leg\n  FROM api),\nbursts AS (\n  SELECT s, h FROM legs WHERE leg = 3 GROUP BY s, h HAVING COUNT(*) >= 20 AND MAX(t) - MIN(t) <= 300),\nqlegs AS (\n  SELECT l.s, l.t, CASE WHEN l.leg = 3 AND NOT (l.d LIKE '%api03-%' OR EXISTS (SELECT 1 FROM bursts b WHERE b.s = l.s AND b.h = l.h))\n                        THEN NULL ELSE l.leg END AS leg\n  FROM legs l),\nparents AS (SELECT DISTINCT actor_session_uid AS s, delegation_parent_uid AS p FROM api),\nwalk AS (\n  SELECT s, s AS root, 0 AS depth FROM parents WHERE p IS NULL\n  UNION ALL\n  SELECT c.s, w.root, w.depth + 1 FROM parents c JOIN walk w ON c.p = w.s WHERE w.depth < 8)\nSELECT w.root AS unit FROM qlegs l JOIN walk w ON w.s = l.s WHERE l.leg IS NOT NULL GROUP BY w.root HAVING COUNT(DISTINCT leg) = 3 AND MAX(t) - MIN(t) <= 3600"
 },
