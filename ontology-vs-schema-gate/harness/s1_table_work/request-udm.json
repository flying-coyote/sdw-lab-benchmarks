  ],
  "summary": [
   "security_result.summary"
  ],
  "threat_name": [
   "security_result.threat_name"
  ],
  "url": [
   "target.url"
  ],
  "user": [
   "principal.user"
  ],
  "user_agent": [
   "network.http.user_agent"
  ],
  "user_display_name": [
   "principal.user.user_display_name"
  ],
  "user_role": [
   "principal.user.user_role"
  ],
  "userid": [
   "principal.user.userid",
   "target.user.userid"
  ],
  "vendor_name": [
   "vendor_name"
  ],
  "windows_sid": [
   "principal.user.windows_sid",
   "target.user.windows_sid"
  ]
 }
}